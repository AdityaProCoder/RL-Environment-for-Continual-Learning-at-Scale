{
  "model_name": "Qwen/Qwen3.5-2B",
  "device": "cuda",
  "dtype": "bfloat16",
  "max_new_tokens": 256,
  "temperature": 0.3,
  "top_p": 0.9,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_targets": [
    "q_proj",
    "v_proj"
  ],
  "learning_rate": 0.00035,
  "train_steps_per_update": 3,
  "max_seq_len": 512,
  "families": [],
  "tasks_per_family": 8,
  "episodes_per_task": 1,
  "max_attempts_per_task": 2,
  "gate_epsilon": 0.05,
  "holdout_size": 12,
  "max_updates": 40,
  "use_vsr_gate": true,
  "use_reference_injection": true,
  "vsr_learners": [
    "vsr",
    "vsr_nogold",
    "vsr_bounded"
  ],
  "refinject_learners": [
    "vsr",
    "vsr_bounded"
  ],
  "vault_commit_min": 0.9,
  "vault_retrieve_k": 3,
  "vault_gate_check": 3,
  "anchor_lambda": 0.5,
  "anchor_learners": [
    "vsr_nogold",
    "vsr_bounded"
  ],
  "replay_frac": 0.5,
  "replay_frac_learners": [
    "vsr",
    "vsr_nogold",
    "vsr_bounded"
  ],
  "lr_decay": true,
  "vault_dedup_sim": 0.995,
  "vault_dedup_learners": [
    "vsr",
    "vsr_nogold",
    "vsr_bounded"
  ],
  "self_taught_learners": [
    "vsr_nogold",
    "vsr_self"
  ],
  "self_taught_k": 6,
  "self_taught_temp": 0.7,
  "self_taught_repair_rounds": 1,
  "self_taught_repair_k": 2,
  "out_dir": "runs/vsr_ablation2",
  "seed": 42,
  "enable_grpo": false
}